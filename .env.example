# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Nebius Token Factory API key (required for AI risk identification + sandbox)
# Get yours at: https://nebius.com
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius project ID (required for Sandbox execution)
# Find it in your Nebius dashboard under project settings
NEBIUS_PROJECT_ID=your_project_id_here
